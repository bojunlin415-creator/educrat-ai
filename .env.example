# 僅供本機設定參考，請勿提交真實金鑰。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public 設定可出現在瀏覽器，但仍應使用不同的 local、staging、production 專案。
# 新專案請使用 Supabase Dashboard 提供的 Publishable Key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 私密金鑰只能在伺服器端使用，禁止加上 NEXT_PUBLIC_。
# Sprint 3 不使用 Service Role Key；預留變數供後續受控的伺服器工作。
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# LE-001 Phase 4 shadow diagnostics are explicit opt-in and never change legacy authority.
LEARNER_CONVERGENCE_SHADOW_READ=disabled

# LE-001 Phase 5A server-only roster authority override. Omit for the
# code-selected CANONICAL_PRIMARY_LEGACY_FALLBACK mode; LEGACY_ONLY is rollback.
# Allowed: LEGACY_ONLY, LEGACY_PRIMARY_CANONICAL_SHADOW,
# CANONICAL_PRIMARY_LEGACY_FALLBACK, CANONICAL_ONLY
# LEARNER_CLASS_ROSTER_AUTHORITY_MODE=LEGACY_ONLY
